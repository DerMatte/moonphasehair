{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"app/**/*.{ts,tsx}",
			"components/**/*.{ts,tsx}",
			"hooks/**/*.{ts,tsx}",
			"lib/**/*.{ts,tsx}",
			"public/sw.js",
			"tests/**/*.mjs",
			"biome.json",
			"components.json",
			"images.d.ts",
			"next.config.ts",
			"package.json",
			"postcss.config.mjs",
			"proxy.ts",
			"tsconfig.json",
			"vercel.json",
			"!**/*.gen.ts",
			"!**/globals.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noControlCharactersInRegex": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": false
	}
}
